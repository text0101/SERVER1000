{
    "name": "taxblock-autotally-ai",
    "private": true,
    "version": "0.0.1",
    "description": "AutoTallyAI - Automated Accounting & Tally Integration",
    "author": "Suraj Suryawanshi",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "cd frontend && npm run dev",
        "build": "cd frontend && npm run build",
        "electron:dev": "concurrently -k \"cd frontend && cross-env NODE_ENV=development npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "cd frontend && npm run build && cd .. && electron-builder",
        "electron:dist": "cd frontend && npm run build && cd .. && electron-builder --win",
        "install:all": "cd frontend && npm install && cd ../backend && pip install -r requirements.txt"
    },
    "build": {
        "appId": "com.autotally.ai",
        "productName": "AutoTallyAI",
        "files": [
            "frontend/dist/**/*",
            "electron/**/*",
            "TallyAiLogo00.ico"
        ],
        "directories": {
            "output": "release_v24"
        },
        "win": {
            "target": "nsis",
            "icon": "TallyAiLogo00.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^39.2.7",
        "electron-builder": "^26.0.12",
        "wait-on": "^9.0.3"
    }
}